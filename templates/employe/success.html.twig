{% extends 'base.html.twig' %}

{% block title %}Succès !{% endblock %}

{% block body %}
    {{ include('partials/_navbar.html.twig') }}

    <div style="margin: 20px; padding: 20px; background-color: #d4edda; color: #155724; border-radius: 5px;">
        <h1>Bravo !</h1>
        <p>L'employé a bien été créé :</p>
        <ul>
            <li><strong>Nom :</strong> {{ employe.nom }}</li>
            <li><strong>Prénom :</strong> {{ employe.prenom }}</li>
            <li><strong>Email :</strong> {{ employe.adressEmail }}</li>
        </ul>
        
        <a href="{{ path('app_employe_add') }}">Ajouter un autre employé</a>
    </div>
{% endblock %}